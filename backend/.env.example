# Copy to backend/.env for local development:  Copy-Item .env.example .env
# Never commit backend/.env. In production, set these in the hosting platform's secrets UI.

APP_ENV=development
LOG_LEVEL=INFO
# text (readable locally) | json (hosted log viewers)
LOG_FORMAT=text

# --- Database ------------------------------------------------------------------------------
# Local Docker Compose database (see docker-compose.yml at the repo root).
DATABASE_URL=postgresql+asyncpg://clauselens:clauselens@localhost:5432/clauselens
DB_SSL=false
# Set to 0 only when connecting through a *transaction-mode* pooler (Supabase port 6543).
DB_STATEMENT_CACHE_SIZE=100

# --- HTTP ----------------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (your frontend URL[s]).
CORS_ORIGINS=http://localhost:3000
# Optional regex, e.g. to allow Vercel preview deployments:
# CORS_ORIGIN_REGEX=https://clauselens-.*\.vercel\.app
CORS_ORIGIN_REGEX=

# --- Uploads --------------------------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_PAGES=1000

# --- File storage ---------------------------------------------------------------------------
# local: files under STORAGE_LOCAL_DIR (development).
# supabase: a PRIVATE Supabase Storage bucket (production; container disks are ephemeral).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage
SUPABASE_URL=
# Server-side secret key (service_role / sb_secret_...). Never expose it to the browser.
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# --- Extraction & OCR -----------------------------------------------------------------------
# Scanned pages are OCR'd with Tesseract. If OCR is off or Tesseract is missing, those pages are
# reported as unreadable (never silently skipped).
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=300
# Full path if tesseract is not on PATH, e.g. C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=

# --- Embeddings (local, via fastembed/ONNX; model downloads once to EMBEDDING_CACHE_DIR) ------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed
EMBEDDING_BATCH_SIZE=32

# --- Retrieval (defaults shown; usually no need to change) -----------------------------------
RETRIEVAL_CANDIDATES_PER_LIST=30
RETRIEVAL_DEFAULT_TOP_K=10
RETRIEVAL_MAX_TOP_K=50
RETRIEVAL_MAX_DOCUMENTS=10
RETRIEVAL_MAX_QUERY_CHARS=1000
RETRIEVAL_RRF_K=60
# Semantic-only hits below this cosine similarity are dropped (calibrated for bge-small-en-v1.5).
RETRIEVAL_MIN_DENSE_SIMILARITY=0.55
RETRIEVAL_BM25_K1=1.2
RETRIEVAL_BM25_B=0.75

# --- Background jobs (in-process worker) ----------------------------------------------------
WORKER_ENABLED=true
JOB_MAX_ATTEMPTS=3

# --- LLM (any OpenAI-compatible provider) ---------------------------------------------------
# Examples (check current pricing on the provider's own page before choosing):
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<provider>/<model>
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=<model>
#   DeepSeek:   LLM_BASE_URL=https://api.deepseek.com/v1    LLM_MODEL=<model>
# Leave blank to disable question answering (the rest of the app works; /api/answers returns 503).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=60
LLM_MAX_OUTPUT_TOKENS=900
LLM_TEMPERATURE=0
# Optional; only sent if set (not every provider accepts a seed).
LLM_SEED=

# --- Answering: evidence selection (defaults shown) ------------------------------------------
ANSWER_CANDIDATE_TOP_K=20
ANSWER_MAX_PASSAGES=8
ANSWER_CONTEXT_TOKEN_BUDGET=3000
# Semantic-only passages: similarity >= max(floor, best - margin). Keyword-only: BM25 >= ratio x
# best in the document and at least two of the question's terms.
ANSWER_MIN_DENSE_SIMILARITY=0.60
ANSWER_DENSE_MARGIN=0.07
ANSWER_BM25_RELATIVE=0.5
