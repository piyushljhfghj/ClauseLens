# --- Secrets: never commit real environment files ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / Next.js (frontend/.gitignore has more) ---
node_modules/
.next/
out/
*.tsbuildinfo

# --- Local data ---
backend/storage/
*.log

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# --- Claude Code local state (launch.json is shared, the rest is personal) ---
.claude/*
!.claude/launch.json
